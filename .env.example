# Copy this file to .env and fill in the OpenRouter API key.
# Shot planning uses OpenRouter by default (recommended — avoids ZenMux proxy issues).
OPENROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override prompt LLM. Leave commented unless you need ZenMux for planning.
# LLM_API_KEY=
# LLM_API_URL=https://zenmux.ai/api/v1/chat/completions
# LLM_MODEL=z-ai/glm-4.7-flash-free

# Image generation uses zenmux.env (see zenmux.env.example), not this file.
